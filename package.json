{
  "name": "quicksense",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "dictionary:build": "node scripts/build-dictionary.mjs",
    "service:dev": "wrangler dev --config service/wrangler.jsonc",
    "dictionary:bilingual": "node scripts/build-bilingual.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.0.0",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
